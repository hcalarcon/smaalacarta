# App (Next.js). Copiar a .env.local y completar. Nunca se commitea.
# Project Settings → API Keys del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio (secret key): solo la usa /superadmin para crear cuentas y
# restablecer contraseñas, y el cambio de contraseña temporal.
# Da acceso total a la base: no lleva el prefijo NEXT_PUBLIC_, no se comparte y
# nunca se sube al repositorio. Sin ella el resto del admin funciona igual.
SUPABASE_SERVICE_ROLE_KEY=
