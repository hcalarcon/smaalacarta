# App (Next.js). Copiar a .env.local y completar. Nunca se commitea.
# Project Settings → API Keys del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio (secret key): solo la usa /superadmin para crear cuentas y
# restablecer contraseñas, y el cambio de contraseña temporal.
# Da acceso total a la base: no lleva el prefijo NEXT_PUBLIC_, no se comparte y
# nunca se sube al repositorio. Sin ella el resto del admin funciona igual.
SUPABASE_SERVICE_ROLE_KEY=

# Avisos push del panel instalable. Las claves VAPID se generan una vez con
# `npx web-push generate-vapid-keys` y se cargan en Vercel (Production y Preview).
# La pública va al navegador (NEXT_PUBLIC_); la privada y el secreto, solo al servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto de quien manda, para el servicio push. Ejemplo: mailto:hola@smaalacarta.com.ar
VAPID_SUBJECT=
# Secreto del Database Webhook de Supabase (sobre `orders`) que llama a /admin/api/push/order,
# en el encabezado x-webhook-secret.
PUSH_WEBHOOK_SECRET=
