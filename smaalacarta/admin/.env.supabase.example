# CLI de Supabase (scripts db:link, db:push, db:types). Copiar a .env.supabase
# y completar. Estas claves no las lee la app: no van en .env.local.
#
# Access token personal de la cuenta dueña del proyecto (Account → Access
# Tokens). Tiene prioridad sobre el `supabase login`, así que no hace falta
# cambiar de cuenta en la CLI. Cada persona usa el suyo.
SUPABASE_ACCESS_TOKEN=
# Contraseña de la base (Project Settings → Database).
SUPABASE_DB_PASSWORD=
