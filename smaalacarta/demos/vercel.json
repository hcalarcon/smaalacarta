{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "moderno.smaalacarta.com.ar"
        }
      ],
      "destination": "/carrito/modern/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "clasico.smaalacarta.com.ar"
        }
      ],
      "destination": "/carrito/classic/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "minimal.smaalacarta.com.ar"
        }
      ],
      "destination": "/carrito/minimalist/$1"
    },
    {
      "source": "/moderno",
      "destination": "/menu-html/modern"
    },
    {
      "source": "/clasico",
      "destination": "/menu-html/classic"
    },
    {
      "source": "/minimal",
      "destination": "/menu-html/minimalist"
    }
  ]
}
