{
  "rewrites": [
    {
      "source": "/moderno",
      "destination": "/apps/menu-html/modern"
    },
    {
      "source": "/clasico",
      "destination": "/apps/menu-html/classic"
    },
    {
      "source": "/minimal",
      "destination": "/apps/menu-html/minimalist"
    },

    {
      "source": "/:cliente/pdf",
      "destination": "/apps/pdf/index.html"
    },

    {
      "source": "/pdf",
      "has": [{ "type": "host", "value": "demo.*" }],
      "destination": "/apps/pdf/index.html"
    },

    {
      "source": "/((?!apps|data|templates|.*\\..*).*)",
      "destination": "/apps/menu-app/index.html"
    }
  ]
}
