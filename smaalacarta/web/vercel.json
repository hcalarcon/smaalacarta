{
  "rewrites": [
    {
      "source": "/:cliente/pdf",
      "destination": "/apps/pdf/index.html"
    },

    {
      "source": "/pdf",
      "has": [{ "type": "host", "value": "demo.*" }],
      "destination": "/apps/pdf/index.html"
    },

    {
      "source": "/:cliente/menu.html",
      "destination": "/api/static-menu?slug=:cliente"
    },

    {
      "source": "/pedido/:code",
      "destination": "/apps/tracker/index.html"
    },

    {
      "source": "/((?!api|apps|data|templates|.*\\..*).*)",
      "destination": "/apps/menu-app/index.html"
    }
  ]
}
