{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "preview", "value": "1" }],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://www.smaalacarta.com.ar"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pdf",
      "destination": "/apps/pdf/index.html"
    },

    {
      "source": "/menu.html",
      "destination": "/api/static-menu"
    },

    {
      "source": "/pedido/:code",
      "destination": "/apps/tracker/index.html"
    },

    {
      "source": "/vitrina",
      "destination": "/apps/vitrina/index.html"
    },

    {
      "source": "/vitrina/:tema(arcade|floral|futurista|natural|fantasia)",
      "destination": "/apps/vitrina/:tema/index.html"
    },

    {
      "source": "/((?!api|apps|data|templates|.*\\..*).*)",
      "destination": "/apps/menu-app/index.html"
    }
  ]
}
